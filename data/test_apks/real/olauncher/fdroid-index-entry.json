      "he": "\u05d9\u05d9\u05e9\u05d5\u05de\u05d5\u05df \u05de\u05e9\u05d2\u05e8 \u05de\u05d6\u05e2\u05e8\u05d9 \u05e2\u05dd \u05d8\u05e4\u05d8 \u05d9\u05d5\u05de\u05d9 \u05d7\u05d3\u05e9",
