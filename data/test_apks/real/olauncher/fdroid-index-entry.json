    "summary": {
      "ar": "\u062a\u0637\u0628\u064a\u0642 \u0645\u0634\u063a\u0644 \u0628\u0633\u064a\u0637 \u0645\u0639 \u062e\u0644\u0641\u064a\u0629 \u064a\u0648\u0645\u064a\u0629 \u062c\u062f\u064a\u062f\u0629",
      "ba": "\u041a\u04e9\u043d \u04bb\u0430\u0439\u044b\u043d \u044f\u04a3\u044b \u044d\u043a\u0440\u0430\u043d \u0444\u043e\u043d\u044b \u043c\u0435\u043d\u04d9\u043d \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c \u043b\u0430\u0443\u043d\u0447\u0435\u0440 \u04a1\u0443\u0448\u044b\u043c\u0442\u0430\u04bb\u044b",
